# Copy to .env and keep it private. Blank values need your deployment-specific input.
# Start with FEATURE_ENABLED=false; configure and run preflight before activation.
# For each secret, use its direct value OR the commented *_FILE alternative.
# Secret files must be readable inside the running process/container; restart to reload.
# The normal Compose file loads .env. The secrets variant uses explicit mounted files:
# it always enables TLS verification. Optional HA/microphone secrets use separate overrides.

# -----------------------------------------------------------------------------
# Application mode and local management
# -----------------------------------------------------------------------------

# Start automatic camera/provider/audio activity on boot; false starts disarmed.
FEATURE_ENABLED=false

# greeting_only plays one greeting; interactive also listens and answers visitor speech.
CONVERSATION_MODE=greeting_only

# Arrival source: webhook (primary), websocket, or webhook_with_websocket_fallback.
TRIGGER_SOURCE=webhook

# Secret bearer token for local status, readiness, enable, cancel and test commands.
CONTROL_API_TOKEN=
# CONTROL_API_TOKEN_FILE=/run/secrets/control_api_token

# -----------------------------------------------------------------------------
# UniFi Protect connection and selected doorbell
# Required for active operation, including when webhooks provide arrival events.
# -----------------------------------------------------------------------------

# Protect console hostname/IP only, without http://, https:// or a URL path.
UNIFI_HOST=

# Protect HTTPS port.
UNIFI_PORT=443

# Local-access Protect account; cloud/MFA logins are not used by this adapter.
UNIFI_USERNAME=
# UNIFI_USERNAME_FILE=/run/secrets/unifi_username

# Password for that local account.
UNIFI_PASSWORD=
# UNIFI_PASSWORD_FILE=/run/secrets/unifi_password

# Protect API key used for the public talkback session API; separate from webhook auth.
UNIFI_API_KEY=
# UNIFI_API_KEY_FILE=/run/secrets/unifi_api_key

# Camera ID used by uiprotect for snapshots/talkback; discover with check_protect.
UNIFI_CAMERA_ID=

# Verify Protect's TLS certificate. Install a trusted CA rather than disabling this.
# Applies to uiprotect only; incoming RTSPS has its own verification enabled.
UNIFI_VERIFY_SSL=true

# -----------------------------------------------------------------------------
# Webhook network binding, authentication and scope
# Required when TRIGGER_SOURCE includes webhook. No unique event ID is assumed.
# -----------------------------------------------------------------------------

# Compose-only host interface for port 8080. Replace loopback with the actual LAN IP
# for Protect delivery; management port 8000 remains loopback. Firewall to Protect/proxy.
DOCKER_LAN_IP=127.0.0.1

# High-entropy webhook secret, at least 32 characters; distinct from CONTROL_API_TOKEN.
UNIFI_WEBHOOK_TOKEN=
# UNIFI_WEBHOOK_TOKEN_FILE=/run/secrets/unifi_webhook_token

# Header carrying the webhook token. Verify POST custom-header support in Protect;
# otherwise use the documented LAN proxy setup to inject this header.
UNIFI_WEBHOOK_TOKEN_HEADER=X-Unifi-Token

# Comma-separated device identifiers from the real webhook payload. These may be MACs,
# not UNIFI_CAMERA_ID; all listed identifiers must refer to that same physical doorbell.
UNIFI_WEBHOOK_ALLOWED_CAMERA_IDS=

# Comma-separated allowed socket-peer IPs/CIDRs (console, or explicitly trusted proxy).
# Forwarded source headers are ignored; verify the actual peer through the diagnostic.
UNIFI_WEBHOOK_ALLOWED_SOURCE_IPS=

# Comma-separated exact Alarm Manager names allowed to start a porch session.
UNIFI_WEBHOOK_ALLOWED_ALARM_NAMES=

# Comma-separated exact trigger keys observed for person detection/optional doorbell
# presses on your installation. Do not guess keys from illustrative payloads.
UNIFI_WEBHOOK_ALLOWED_TRIGGERS=

# Maximum accepted request-body size in bytes; valid range 512-65536.
UNIFI_WEBHOOK_MAX_BODY_BYTES=16384

# Maximum past/future timestamp skew in seconds; valid range 1-600.
# Incoming timestamps must be integer Unix milliseconds.
UNIFI_WEBHOOK_MAX_SKEW_SECONDS=120

# Time-bucket width in seconds for camera/alarm/trigger deduplication; range 1-60.
UNIFI_WEBHOOK_DEDUPE_SECONDS=10

# Maximum pending normalized webhook events; range 1-256. Full queues return 429.
UNIFI_WEBHOOK_QUEUE_SIZE=32

# -----------------------------------------------------------------------------
# AI provider, model roles and character
# Choose account-supported models with the required capabilities; no IDs are implied.
# -----------------------------------------------------------------------------

# OpenAI API credential for vision, dialogue, moderation, speech and transcription.
OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key

# Image-capable Responses model supporting structured costume descriptions.
VISION_MODEL=

# Responses model supporting structured, short family-friendly dialogue.
DIALOGUE_MODEL=

# File-transcription model; required only for interactive operation.
STT_MODEL=

# Speech synthesis model supporting WAV output.
TTS_MODEL=

# Text moderation model used to check generated dialogue before speech synthesis.
MODERATION_MODEL=

# Voice supported by the selected speech model; actual account/model access needs testing.
TTS_VOICE=alloy

# Built-in character: haunted_butler, friendly_witch or silly_skeleton.
# All characters retain the same family-friendly rules.
PERSONALITY=haunted_butler

# Maximum seconds for each controller provider stage; positive, at most 30.
PROVIDER_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Snapshot capture and frame selection
# -----------------------------------------------------------------------------

# Capture 1-3 frames per session and select using an exposure/contrast heuristic.
SNAPSHOT_COUNT=3

# Seconds between frames; range 0-1. Does not guarantee recognition quality.
SNAPSHOT_INTERVAL_SECONDS=0.2

# -----------------------------------------------------------------------------
# Incoming microphone and speech detection (interactive mode only)
# -----------------------------------------------------------------------------

# Supported authenticated RTSP(S) microphone URL from your Protect installation.
# Treat the entire URL as secret. Do not guess paths or use a talkback session URL.
# Credentials/token presence is only a configuration check, not proof of enforced auth.
UNIFI_AUDIO_STREAM_URL=
# UNIFI_AUDIO_STREAM_URL_FILE=/run/secrets/unifi_audio_stream_url

# Maximum listening window per visitor reply, in seconds; positive, at most 8.
LISTEN_TIMEOUT_SECONDS=8

# WebRTC VAD noise-filter aggressiveness, 0-3; higher rejects more possible speech.
VAD_AGGRESSIVENESS=2

# Consecutive voiced onset before speech is accepted; range 30-1000 milliseconds.
# VAD timings round up to full 30 ms frames.
VAD_ONSET_MS=210

# Trailing silence ending an utterance; range 30-2000 milliseconds.
VAD_SILENCE_MS=720

# -----------------------------------------------------------------------------
# Doorbell output and approved fallback audio
# -----------------------------------------------------------------------------

# Maximum seconds awaiting doorbell playback; positive, at most 30.
PLAYBACK_TIMEOUT_SECONDS=15

# Keep microphone input closed this many milliseconds after playback; range 0-5000.
# Also guards against residual sound from the separate effects speaker.
AUDIO_ECHO_GUARD_MS=400

# Reviewed short PCM WAV used if generation/synthesis fails. Required for activation.
# Use a path inside the container, e.g. /media/fallback.wav with the media Compose file.
FALLBACK_WAV=

# Reviewed short PCM goodbye WAV used for normal final closure; required for activation.
# Use a path inside the container, e.g. /media/goodbye.wav. Both WAVs must be complete
# mono/stereo PCM, <=10 seconds, <=2 MB, and have an 8-192 kHz sample rate.
GOODBYE_WAV=

# -----------------------------------------------------------------------------
# Session limits and retrigger suppression
# -----------------------------------------------------------------------------

# Maximum visitor replies, excluding the opening greeting; valid range 1-3.
MAX_VISITOR_REPLIES=3

# Overall conversation deadline in seconds; positive, at most 120 (default target 45).
# Cancellation and the deadline can interrupt playback, including a goodbye.
MAX_SESSION_SECONDS=45

# Minimum post-session suppression in seconds; zero or greater.
COOLDOWN_SECONDS=30

# Required quiet interval since the last accepted detection before rearming, in seconds.
# This is an inactivity heuristic, not proof that the porch is physically empty.
PORCH_CLEAR_SECONDS=10

# -----------------------------------------------------------------------------
# Home Assistant connection and porch lighting
# Optional: missing/unavailable HA degrades effects while dialogue continues.
# -----------------------------------------------------------------------------

# Existing HA base URL, reachable from the container; .local DNS may need local setup.
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# HA long-lived access token; separate from Protect, webhook and control tokens.
HOME_ASSISTANT_TOKEN=
# HOME_ASSISTANT_TOKEN_FILE=/run/secrets/home_assistant_token

# Enable Halloween lighting and optional stingers; false leaves existing lights alone.
# Maintain safe baseline path lighting independently of optional effects.
EFFECTS_ENABLED=true

# Comma-separated designated light.* entity IDs to snapshot/change/conditionally restore.
# Do not include unrelated household lights or competing arrival/end automations.
HUE_CONTROLLED_ENTITIES=

# Optional imported porch-only scene.* entity; blank uses direct purple/orange lighting.
HUE_ARRIVAL_SCENE=

# Set true only after verifying that the scene affects solely the designated porch lights.
# Required when HUE_ARRIVAL_SCENE is set; otherwise the scene cue is refused.
HUE_SCENE_SCOPE_CONFIRMED=false

# Only supported restore mode: restore prior state if ownership checks still match.
# This is not an atomic REST transaction; newer manual changes cause restore to be skipped.
HUE_RESTORE_MODE=snapshot_conditional

# Maximum seconds per effects lifecycle hook; positive, at most 10. Also HA HTTP timeout.
# HA failures must not block the webhook acknowledgement or prevent the greeting.
EFFECTS_TIMEOUT_SECONDS=3

# Lighting transition duration in seconds; range 0.5-1.5. No flashing/strobing.
EFFECTS_TRANSITION_SECONDS=1

# -----------------------------------------------------------------------------
# Optional HA effects speaker (separate from doorbell dialogue)
# No speaker settings are needed while EFFECTS_SPEAKER_ENABLED=false.
# -----------------------------------------------------------------------------

# Opt into short arrival stingers; independent of lighting and spoken dialogue.
EFFECTS_SPEAKER_ENABLED=false

# Must be true to play stingers: confirms a dedicated effects player, not household media.
EFFECTS_SPEAKER_DEDICATED=false

# HA media_player.* entity for the dedicated effects speaker.
EFFECTS_SPEAKER_ENTITY_ID=

# Owned/licensed short audio asset at an HTTP(S) URL reachable by HA/the player.
# Docker-local filesystem paths cannot be played remotely.
EFFECTS_SOUND_URL=

# Volume ceiling on a 0-1 scale, constrained to 0-0.30; never raises a lower current volume.
EFFECTS_MAX_VOLUME=0.30

# Seconds before requesting stinger stop; positive, at most 10. Use an asset no longer
# than this duration. An unreachable player cannot guarantee a physical stop.
EFFECTS_MAX_DURATION_SECONDS=4

# Daily stinger-only quiet hours, HH:MM-HH:MM; overnight ranges supported.
# Blank disables quiet hours in either deployment. Lighting/voice are unaffected.
EFFECTS_QUIET_HOURS=22:00-09:00

# IANA timezone used for stinger quiet hours, independent of the container's local clock.
EFFECTS_TIMEZONE=America/New_York
